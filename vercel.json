  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/collect-articles",
      "schedule": "0 20 * * 1,4"
    },
    {
      "path": "/api/cron/send-queue",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/bounce-scan",
      "schedule": "0 22 * * *"
    },
    {
